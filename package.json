{
  "name": "zenn-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "textlint \"articles/**/*.md\" \"books/**/*.md\" README.md",
    "lint:fix": "textlint --fix \"articles/**/*.md\" \"books/**/*.md\" README.md",
    "preview": "zenn preview",
    "new:art": "zenn new:article",
    "new:book": "zenn new:book"
  },
  "dependencies": {
    "zenn-cli": "0.5.4"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-spacing": "3.0.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.21.0"
}
